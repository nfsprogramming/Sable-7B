.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter & Notebook Checkpoints
.ipynb_checkpoints/

# Experiment Logging & Profiling
*.log
wandb/
runs/

# IDE & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

